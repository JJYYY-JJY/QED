# QED does not load this file. Export these values in the service process.
# Leave the token unset for the tokenless loopback browser console.
# A non-loopback service or BFF hop requires a server-side token. Generate one with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# QED_AUTH_TOKEN=replace-with-the-generated-value
QED_DATABASE_NAME=qed.sqlite3
QED_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
