{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJYYY-JJY/QED/benchmarks/reliability/request.schema.json",
  "title": "QED reliability benchmark blinded execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "case_id",
    "case_sha256",
    "repetition",
    "statement",
    "candidate_proof",
    "verification_rules",
    "citation",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+::[0-9]{3,}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "candidate_proof": {
      "type": "string",
      "minLength": 1
    },
    "verification_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "case.schema.json#/$defs/citation"
        }
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
